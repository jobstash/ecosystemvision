{
  "name": "projectsfyi",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "next dev --webpack",
    "prebuild": "node tools/scripts/generate-sitemap.js",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint ./src",
    "lint:staged": "lint-staged",
    "lint:fix": "eslint ./src --fix",
    "format": "prettier --write 'src/**/*.{js,ts,tsx,jsx,json,css,html}'",
    "test": "node --test tools/scripts/*.test.js",
    "prepare": "husky",
    "push": "git push origin $(git rev-parse --abbrev-ref HEAD)",
    "pull": "node scripts/pull-remote.js",
    "e2e": "npx playwright test",
    "e2e:report": "npx playwright show-report --host=0.0.0.0",
    "e2e:h": "npx playwright test --headed --project=chromium",
    "e2e:h:m": "npx playwright test --headed --project=chromium.mobile",
    "e2e:h:t": "npx playwright test --headed --project=chromium.tablet",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build:app": "next build --webpack"
  },
  "dependencies": {
    "@deck.gl/core": "9.4.1",
    "@deck.gl/layers": "9.4.1",
    "@deck.gl/react": "9.4.1",
    "@heroui/react": "3.2.7",
    "@heroui/styles": "3.2.7",
    "@next/bundle-analyzer": "16.4.5",
    "@next/third-parties": "16.4.5",
    "@sentry/nextjs": "11.11.0",
    "@splinetool/react-spline": "4.2.0",
    "@splinetool/runtime": "2.0.146",
    "@tanstack/react-query": "5.106.1",
    "@tanstack/react-virtual": "3.14.26",
    "clsx": "2.1.1",
    "d3-scale": "4.0.3",
    "echarts": "6.1.0",
    "flint-chart": "1.0.1",
    "framer-motion": "14.10.0",
    "gsap": "3.15.1",
    "jotai": "3.0.1",
    "lucide-react": "1.70.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "react-hot-toast": "2.6.1",
    "react-intersection-observer": "11.0.1",
